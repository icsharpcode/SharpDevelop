<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="ICSharpCode.SpellChecker.Windows.SetLanguageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	WindowStyle="ToolWindow"
	Title="Dictionaries"
	Height="302"
	Width="302">
	<Window.Resources>
		<Style
			x:Key="LinkButton"
			TargetType="Button">
			<Setter
				Property="Template">
				<Setter.Value>
					<ControlTemplate
						TargetType="Button">
						<ControlTemplate.Resources>
							<Style
								TargetType="{x:Type TextBlock}">
								<Setter
									Property="TextDecorations"
									Value="Underline" />
							</Style>
						</ControlTemplate.Resources>
						<ContentPresenter />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Setter
				Property="Foreground"
				Value="Blue" />
			<Setter
				Property="Cursor"
				Value="Hand" />
			<Style.Triggers>
				<Trigger
					Property="IsMouseOver"
					Value="true">
					<Setter
						Property="Foreground"
						Value="Red" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="30"
				MaxHeight="30" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				MaxWidth="150"
				Width="150" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Label
			Content="Installed Dictionaries"
			VerticalAlignment="Bottom" />
		<ListView
			Name="DictionariesList"
			Grid.Row="1" />
		<Button
			Content="Default"
			Name="DefaultButton"
			Grid.Column="1"
			Grid.Row="1"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Margin="9,0,0,0"
			Width="125"
			Height="23"
			Click="DefaultButton_Click" />
		<Button
			Content="OpenOffice dictionaries"
			Style="{StaticResource LinkButton}"
			Name="LinkButton"
			Grid.Column="1"
			Grid.Row="1"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			Margin="9,207,0,0"
			Width="125"
			Height="23"
			Click="LinkButton_Click" />
	</Grid>
</Window>