<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="ICSharpCode.SpellChecker.Windows.SetLanguageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:widgets="http://icsharpcode.net/sharpdevelop/widgets" xmlns:core="http://icsharpcode.net/sharpdevelop/core"
	Style="{x:Static core:GlobalStyles.DialogWindowStyle}"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	WindowStyle="ToolWindow"
	Title="Dictionaries"
	Height="302"
	Width="302">
	<Window.Resources>
		<Style
			x:Key="LinkButton"
			TargetType="Button" BasedOn="{x:Static core:GlobalStyles.ButtonStyle}">
			<Setter
				Property="Template">
				<Setter.Value>
					<ControlTemplate
						TargetType="Button">
						<ControlTemplate.Resources>
							<Style
								TargetType="{x:Type TextBlock}">
								<Setter
									Property="TextDecorations"
									Value="Underline" />
							</Style>
						</ControlTemplate.Resources>
						<ContentPresenter />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Setter
				Property="Foreground"
				Value="Blue" />
			<Setter
				Property="Cursor"
				Value="Hand" />
			<Style.Triggers>
				<Trigger
					Property="IsMouseOver"
					Value="true">
					<Setter
						Property="Foreground"
						Value="Red" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="30"
				MaxHeight="30" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Label
			Content="{core:Localize XML.MainMenu.ToolsMenu.SpellChecker.InstalledDictionaries}"
			VerticalAlignment="Top" />
		<ListView
			Name="DictionariesList"
			Grid.Row="1" />
		<widgets:UniformGridWithSpacing
			Grid.Column="1"
			Grid.Row="1"
			Columns="1"
			Margin="0,8"
			HorizontalAlignment="Center"
			VerticalAlignment="Top">
			<Button
				VerticalAlignment="Top"
				Style="{x:Static core:GlobalStyles.ButtonStyle}"
				Content="{core:Localize XML.MainMenu.ToolsMenu.SpellChecker.SetDefault}"
				Name="DefaultButton"
				Click="DefaultButton_Click" />
		</widgets:UniformGridWithSpacing>
		<Button
			Content="{core:Localize XML.MainMenu.ToolsMenu.SpellChecker.Dictionaries}"
			Style="{StaticResource LinkButton}"
			Name="LinkButton"
			Grid.Row="1"
			Grid.Column="1"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			Click="LinkButton_Click" />
	</Grid>
</Window>